{
  "name": "pelu-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:test": "tsc && vite build --mode test",
    "build:prod": "tsc && vite build --mode production",
    "preview": "vite preview",
    "deploy": "gcloud run deploy luu --source . --region us-central1 --allow-unauthenticated",
    "deploy:test": "npm run build:test && npx firebase-tools hosting:channel:deploy test --project pelu-harliz-green-df830 --expires 30d",
    "deploy:prod": "npm run build:prod && npx firebase-tools deploy --only hosting --project pelu-harliz-green-df830",
    "deploy:firebase": "npm run deploy:prod"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^13.15.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
